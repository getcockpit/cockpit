{
  "manifest_version": 3,
  "name": "Cockpit annotations",
  "version": "0.1.0",
  "description": "Pin problems on a page and send them to a Cockpit session, only after you review and confirm.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "nativeMessaging", "storage"],
  "optional_host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Link this tab to a Cockpit session (⌥⇧A)" },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+A" }, "description": "Link this tab to a Cockpit session" }
  }
}
