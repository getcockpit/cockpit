{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cockpit",
  "version": "0.1.0",
  "identifier": "dev.minorityreport.app",
  "build": {
    "beforeDevCommand": "bun run --cwd ui dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run --cwd ui build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cockpit",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/mr-sidecar",
      "binaries/mr-dictate"
    ]
  }
}
