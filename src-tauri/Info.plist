<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged into Cockpit.app's Info.plist by Tauri. macOS asks the app that launched mr-dictate for
     microphone and speech permission, so the app needs these strings too, not only the helper. -->
<plist version="1.0">
<dict>
  <key>NSMicrophoneUsageDescription</key><string>Cockpit listens while you hold ⌥ Space so you can talk to your sessions.</string>
  <key>NSSpeechRecognitionUsageDescription</key><string>Cockpit turns what you say into text on this Mac.</string>
</dict>
</plist>
