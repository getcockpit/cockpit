{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cockpit Remote",
  "version": "0.1.0",
  "identifier": "dev.getcockpit.remote",
  "build": {
    "beforeDevCommand": "bun run --cwd ../ui dev:mobile",
    "devUrl": "http://localhost:1422",
    "beforeBuildCommand": "bun run --cwd ../ui build:mobile",
    "frontendDist": "../../ui/dist-mobile"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cockpit Remote",
        "width": 390,
        "height": 844
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "iOS": {
      "minimumSystemVersion": "17.0",
      "frameworks": [
        "SystemConfiguration"
      ]
    }
  }
}
